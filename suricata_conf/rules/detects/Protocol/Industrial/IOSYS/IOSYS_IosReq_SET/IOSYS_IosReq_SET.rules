alert tcp $HOME_NET any -> $HOME_NET 55555 (msg:"IosReq_OPEN command"; flow:to_server,established; content:"|00 01|"; offset:4; depth:2; classtype:protocol-command-decode; sid:80000081; rev:1; flowbits:set, iosreq_open; flowbits:noalert;)
