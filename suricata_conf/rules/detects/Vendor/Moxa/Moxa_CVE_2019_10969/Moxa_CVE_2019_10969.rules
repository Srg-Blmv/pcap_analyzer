alert tcp any 23 -> any any (msg:"CVE-2019-10969 Ping Command Injection"; content: "MOXA"; content: "EDR"; content: "810"; content: "start to ping"; flowbits:set, moxa_com_inj; flowbits: noalert; reference:url,nvd.nist.gov/vuln/detail/cve-2019-10969; classtype:shellcode-detect; sid:90000010; rev:1;)
alert tcp any 23 -> any any (msg:"CVE-2019-10969 Ping Command Injection"; flowbits:isset, moxa_com_inj; pcre: "/\x2d\x3e\x20(?i)(?:\b(sh|bash|cmd|powershell)\b|[;&|]{1,2}.*?\b(?:wget|curl|whoami|id|nc|netcat|python|perl)\b)(?![^ ]*(?:\d{1,3}\.){3}\d{1,3})/i"; reference:url,nvd.nist.gov/vuln/detail/cve-2019-10969; classtype:shellcode-detect; sid:90000011; rev:1;)