alert http any any -> any any (msg:"Fastwel PLC OS Command Injection"; flow: established, to_server; content:"POST"; http_method; content:"/commands/"; http_uri; pcre:"/\/commands\/[^\/]+\.sh/i"; nocase; http.cookie; content: "cxpsimpleauthssid="; classtype:shellcode-detect; sid:90000013; rev:1;)
alert http any any -> any any (msg:"Fastwel PLC Attempt to unsafely update PLC firmware"; flow: established, to_server; content:"POST"; http_method; content:"/data_active/"; http_uri; pcre:"/\/data_active\/(ffw|norm)\.(dnl|upl)/i"; nocase; classtype:denial-of-service; sid:90000014; rev:1;)
alert http any any -> any any (msg:"Fastwel PLC. XB set fastwel.auth.everyone"; flow: established, to_server; http.header; content: "x-cxpress-login: login"; http.request_body; content: "Everyone|3A|"; nocase; startswith; xbits: set, fastwel.auth.everyone, track ip_src, expire 15; flowbits: noalert; classtype: attempted-admin; sid: 90000015; rev: 1;)
alert http any any -> any any (msg:"Fastwel PLC Unprivileged User Critical Action"; flow: established, to_server; http.uri; content: "/commands/"; pcre: "/^(?:delete_config.sh|restart_target.sh)/RU"; http.cookie; content: "cxpsimpleauthssid="; xbits: isset, fastwel.auth.everyone, track ip_src; classtype: attempted-admin; sid: 90000016; rev: 1;)
alert http any any -> any any (msg:"Fastwel PLC Disclosure of administrator credentials"; flow: established, to_server; content:"GET"; http_method; content:"/data/"; http_uri; pcre:"/CODESYSControl(F|T)\.cfg/i"; nocase; classtype:attempted-admin; sid:90000017; rev:1;)
alert http any any -> any any (msg:"Fastwel PLC Brute-force session token selection"; flow: established, to_server; content:"GET"; http_method; content:"/commands/date.sh"; http_uri; pcre:"/cxpsimpleauthssid=[0-9]+/i"; nocase; threshold:type both, track by_src, count 10, seconds 5; classtype: attempted-admin; sid:90000018; rev:1;)
alert http any any -> any any (msg:"Fastwel PLC Arbitrary code in an authenticated user's browser using URL scheme substitution";flow: established, to_server; content:"GET"; http_method; content:"/login.html?redirectedfrom="; http_uri; pcre:"/(http:\/\/[^\\s]+|javascript:[^\\s]+)/U"; nocase; classtype: attempted-admin; sid:90000019; rev:1;)
alert http any any -> any any (msg:"Fastwel PLC Web server denial of service"; flow: established, to_server; pcre:"/^(?!GET |POST |PUT |DELETE |HEAD |OPTIONS |TRACE |CONNECT )[A-Z]+ /smi"; threshold:type both, track by_src, count 10, seconds 10; classtype: attempted-admin; sid:90000020; rev:1;)
