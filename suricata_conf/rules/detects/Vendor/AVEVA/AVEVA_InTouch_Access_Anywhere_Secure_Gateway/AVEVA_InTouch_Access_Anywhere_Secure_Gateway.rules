alert http any any -> $HOME_NET 8080 (msg: "AVEVA InTouch Access Anywhere and Plant SCADA Access Anywhere use outdated OpenSSL versions that are vulnerable to a classic buffer overflow, which could allow an attacker to create denial-of-service conditions or execute arbitrary code "; flow: established, to_server; urilen: >106; content: "GET"; http_method; content: "/AccessAnywhere/"; http_raw_uri; depth: 16; content: "%252e%252e%255c%252e%252e%255c%252e%252e%255c%252e%252e%255c%252e%252e%255c%252e%252e%255c%252e%252e%255c%252e%252e%255c%252e%252e%255c%252e%252e%25"; distance: 0; classtype: attempted-dos; reference: url, https://www.aveva.com/content/dam/aveva/documents/support/cyber-security-updates/SecurityBulletin_AVEVA-2023-001_r.pdf; sid: 20000008; metadata: created_at 2025_11_02; metadata: updated_at 2025_11_02; rev: 1;)
