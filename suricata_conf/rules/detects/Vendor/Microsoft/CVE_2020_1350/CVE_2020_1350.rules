alert tcp any any -> any 53 (msg: "Windows Server DNS RCE aka SIGRed (CVE-2020-1350)"; flow: established, to_server; content: "|FF|"; depth: 1; byte_test: 1, =, 0x28, 4; content: "|C0 0C 00 18 00 01|"; within: 200; content: "|FF|"; distance: 4; within: 1; reference: url, research.checkpoint.com/2020/resolving-your-way-into-domain-admin-exploiting-a-17-year-old-bug-in-windows-dns-servers/; reference: cve, 2020-1350; classtype: attempted-admin; sid: 10005975; rev: 1; priority:4;)
