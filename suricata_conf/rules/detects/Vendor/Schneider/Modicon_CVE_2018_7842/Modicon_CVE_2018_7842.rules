alert tcp any any -> any 502 (msg:"CVE-2018-7852 Modicon. Attempt to escalate privileges using brute force"; flow: established, to_server; content: "|00 00|"; offset:2; content: "|5a|"; offset:7; pcre:"/[\x01-\xFF][\x40\x41]/"; content: "|ff ff 00 00|"; threshold: type threshold, track by_src, count 10, seconds 10; reference:url,nvd.nist.gov/vuln/detail/cve-2018-7842; classtype:attempted-user; sid:90000023; rev:1;)
