alert tcp any 502 -> any any (msg:"CVE-2018-7852 Modicon. Successful user privilege escalation"; flow: established, from_server; content: "|00 00|"; offset:2; content: "|5a|"; offset:7; content: "|fe|"; offset:9; depth:1; flowbits: isset, AuthBypass; reference:url,nvd.nist.gov/vuln/detail/cve-2018-7842; classtype:successful-user; sid:90000025; rev:1;)